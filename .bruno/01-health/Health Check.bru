meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/{{api_version}}/health
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has status field", function() {
    expect(res.body.status).to.be.a('string');
  });
}
